// ═══════════════════════════════════════════════════════════════════════════
//  GYM APP — Production-Grade CD Pipeline
//  Stage 3: Continuous Deployment
//
//  Sub-stages:
//    3a. Triggered automatically by CI (gym-ci) with IMAGE_TAG param
//    3b. AI Deployment Analysis  — risk score, impact, rollback strategy
//    3c. Slack Approval Gate     — interactive Block Kit; 4-hour timeout
//    3d. Post-Approval AI        — runbook (APPROVE) or fix-list (REJECT)
//    3e. GitOps Manifest Update  — yq patches helm/gym/values.yaml
//    3f. ArgoCD Sync             — force sync + health poll
//    3g. Post-Deployment Verify  — 10-min AI health watch + Slack summary
//
//  Non-functional requirements enforced:
//    • Approval Audit  — every decision logged with timestamp + approver
//    • Slack Gate      — NO bypass; no deploy without explicit approval
//    • Fail-fast       — set -euo pipefail in all shell; error() on failures
//    • AI Transparency — all AI output clearly labeled; human-in-the-loop
//    • AI Privacy      — no PII / secrets sent to LLM
//    • Zero plaintext  — all creds from Jenkins credential store
//    • Observability   — cdLog() structured lines + timestamps() plugin
// ═══════════════════════════════════════════════════════════════════════════

pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
        timeout(time: 6, unit: 'HOURS')   // outer CD timeout (approval + deploy)
    }

    // ── Parameters received from the CI pipeline ────────────────────────────
    // These are injected by `build(job: 'gym-cd', parameters: [...])` in Jenkinsfile.ci
    parameters {
        string(name: 'IMAGE_TAG',   defaultValue: '',    description: 'Versioned image tag from CI (BUILD_NUMBER)')
        string(name: 'GIT_COMMIT',  defaultValue: '',    description: 'Full git commit SHA that was built')
        string(name: 'GIT_BRANCH',  defaultValue: 'main', description: 'Source branch that triggered CI')
        string(name: 'FULL_IMAGE',  defaultValue: '',    description: 'Full image reference: user/gym:<tag>')
    }

    // ── Environment — NO plaintext secrets ──────────────────────────────────
    environment {
        APP_NAME              = 'gym'
        HELM_CHART_PATH       = 'helm/gym'
        GITOPS_BRANCH         = 'main'              // same-branch GitOps (see explanation doc)
        ARGOCD_APP_NAME       = 'gym-app'
        ARGOCD_SERVER         = 'argocd-server.argocd.svc.cluster.local'
        AI_SERVICE_URL        = 'http://ai-devops-service.devops.svc.cluster.local:8000'
        APPROVAL_TIMEOUT_HRS  = '4'
        POST_DEPLOY_WATCH_SEC = '600'               // 10 minutes

        // ── Jenkins credential IDs ────────────────────────────────────────
        AI_API_KEY_CRED_ID        = 'ai-api-key'
        SLACK_BOT_TOKEN_CRED_ID   = 'slack-bot-token'
        SLACK_SIGN_SECRET_CRED_ID = 'slack-signing-secret'
        ARGOCD_TOKEN_CRED_ID      = 'argocd-token'
        GITHUB_CRED_ID            = 'github-credentials'   // Username+Password (PAT)

        // ── Slack channels ────────────────────────────────────────────────
        SLACK_APPROVALS_CHANNEL   = '#deploy-approvals'
        SLACK_DEPLOYMENTS_CHANNEL = '#deployments'

        // ── Runtime state (populated during pipeline) ─────────────────────
        AI_RISK_LEVEL         = ''
        AI_SUMMARY            = ''
        APPROVAL_DECISION     = ''
        APPROVER_ID           = ''
        SLACK_MSG_TS          = ''  // message timestamp for threaded replies
        PRE_DEPLOY_METRICS    = ''
    }

    stages {

        // ════════════════════════════════════════════════════════════════════
        //  3a. AUTOMATED TRIGGER — Validate incoming parameters
        // ════════════════════════════════════════════════════════════════════
        stage('3a · Validate Trigger') {
            steps {
                script {
                    cdLog('3a · Validate Trigger', 'START')

                    if (!params.IMAGE_TAG?.trim()) {
                        error '❌ IMAGE_TAG parameter is required. This job must be triggered by the CI pipeline.'
                    }
                    if (!params.GIT_COMMIT?.trim()) {
                        error '❌ GIT_COMMIT parameter is required.'
                    }

                    echo "▶ IMAGE_TAG  : ${params.IMAGE_TAG}"
                    echo "▶ GIT_COMMIT : ${params.GIT_COMMIT}"
                    echo "▶ GIT_BRANCH : ${params.GIT_BRANCH}"
                    echo "▶ FULL_IMAGE : ${params.FULL_IMAGE}"

                    // Snapshot pre-deployment metrics baseline (best-effort)
                    env.PRE_DEPLOY_METRICS = collectMetricsBaseline()

                    cdLog('3a · Validate Trigger', 'DONE')
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  3b. AI DEPLOYMENT ANALYSIS
        //  Inputs: git diff, CI build summary, current metrics, history
        //  Outputs: risk score, impact analysis, rollback strategy, window
        // ════════════════════════════════════════════════════════════════════
        stage('3b · AI Deployment Analysis') {
            steps {
                script {
                    cdLog('3b · AI Deployment Analysis', 'START')
                    withCredentials([string(credentialsId: AI_API_KEY_CRED_ID, variable: 'AI_API_KEY')]) {

                        // Collect git diff since last tag / deployment
                        def gitLog = sh(
                            script: "git log --oneline -20 --no-merges 2>/dev/null || echo 'git log unavailable'",
                            returnStdout: true
                        ).trim().take(3000)

                        def gitDiff = sh(
                            script: "git diff HEAD~1 HEAD --stat 2>/dev/null || echo 'diff unavailable'",
                            returnStdout: true
                        ).trim().take(2000)

                        // Read CI build summary artifact if available
                        def buildSummary = fileExists('ai-build-summary.json')
                            ? readFile('ai-build-summary.json').take(3000)
                            : '{"summary": "CI build summary not available"}'

                        // Build AI analysis payload — NO secrets, NO PII
                        def payload = groovy.json.JsonOutput.toJson([
                            type            : 'deployment_analysis',
                            app_name        : APP_NAME,
                            image_tag       : params.IMAGE_TAG,
                            git_branch      : params.GIT_BRANCH,
                            git_commit_short: params.GIT_COMMIT.take(7),
                            git_log         : gitLog,
                            git_diff_stat   : gitDiff,
                            ci_build_summary: buildSummary,
                            pre_metrics     : env.PRE_DEPLOY_METRICS,
                            timestamp       : new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
                        ])
                        writeFile file: 'ai-deploy-request.json', text: payload

                        def httpCode = sh(
                            script: """
                                set -euo pipefail
                                curl -sf \
                                  -X POST \
                                  -H "Content-Type: application/json" \
                                  -H "X-API-Key: \${AI_API_KEY}" \
                                  --max-time 120 \
                                  --data @ai-deploy-request.json \
                                  "${AI_SERVICE_URL}/analyze/deployment" \
                                  -o ai-deploy-analysis.json \
                                  -w "%{http_code}"
                            """,
                            returnStdout: true
                        ).trim()

                        echo "▶ AI analysis HTTP status: ${httpCode}"

                        // Parse AI response — fallback gracefully
                        if (fileExists('ai-deploy-analysis.json')) {
                            def analysis = readJSON file: 'ai-deploy-analysis.json'
                            env.AI_RISK_LEVEL = analysis?.risk_level ?: 'UNKNOWN'
                            env.AI_SUMMARY    = analysis?.summary    ?: 'AI analysis unavailable'
                            env.AI_ROLLBACK   = analysis?.rollback_strategy ?: 'Standard rollback: helm rollback gym'
                            env.AI_WINDOW     = analysis?.deployment_window  ?: 'No specific window recommended'
                        } else {
                            env.AI_RISK_LEVEL = 'UNKNOWN'
                            env.AI_SUMMARY    = '⚠️ AI service did not respond — proceeding with manual review'
                            env.AI_ROLLBACK   = 'helm rollback gym -n gym-app'
                            env.AI_WINDOW     = 'N/A'
                        }

                        echo "▶ AI Risk Level: ${env.AI_RISK_LEVEL}"
                    }
                    sh 'rm -f ai-deploy-request.json || true'
                    cdLog('3b · AI Deployment Analysis', "DONE — risk=${env.AI_RISK_LEVEL}")
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'ai-deploy-analysis.json', allowEmptyArchive: true, fingerprint: true
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  3c. SLACK APPROVAL GATE — CRITICAL
        //
        //  Design choice: Option B (Flask webhook-receiver middleware)
        //  Jenkins sends Block Kit message → Slack button click → webhook-receiver
        //  validates Slack signature → POSTs to Jenkins Generic Webhook endpoint
        //  → Jenkins `input` step resolves with APPROVE/REJECT.
        //
        //  Timeout: 4 hours → auto-reject with audit log entry.
        // ════════════════════════════════════════════════════════════════════
        stage('3c · Slack Approval Gate') {
            steps {
                script {
                    cdLog('3c · Slack Approval Gate', 'SENDING APPROVAL REQUEST')

                    withCredentials([string(credentialsId: SLACK_BOT_TOKEN_CRED_ID, variable: 'SLACK_BOT_TOKEN')]) {

                        // Collect recent commits for the approval message
                        def commits = sh(
                            script: "git log --oneline -5 --no-merges 2>/dev/null | head -5",
                            returnStdout: true
                        ).trim()

                        // Build approval Block Kit message with full context
                        def blocks = buildApprovalBlocks(
                            appName    : APP_NAME,
                            imageTag   : params.IMAGE_TAG,
                            fullImage  : params.FULL_IMAGE,
                            branch     : params.GIT_BRANCH,
                            commit     : params.GIT_COMMIT.take(7),
                            commits    : commits,
                            riskLevel  : env.AI_RISK_LEVEL,
                            aiSummary  : env.AI_SUMMARY,
                            buildUrl   : env.BUILD_URL,
                            buildNum   : env.BUILD_NUMBER,
                            timeoutHrs : APPROVAL_TIMEOUT_HRS
                        )

                        def payload = groovy.json.JsonOutput.toJson([
                            channel: SLACK_APPROVALS_CHANNEL,
                            blocks : blocks
                        ])
                        writeFile file: '.slack-approval.json', text: payload

                        // Send the interactive message and capture its timestamp
                        def response = sh(
                            script: """
                                set -euo pipefail
                                curl -sf \
                                  -X POST https://slack.com/api/chat.postMessage \
                                  -H "Authorization: Bearer \${SLACK_BOT_TOKEN}" \
                                  -H "Content-Type: application/json" \
                                  --data @.slack-approval.json
                            """,
                            returnStdout: true
                        ).trim()
                        sh 'rm -f .slack-approval.json || true'

                        def slackResp = readJSON text: response
                        env.SLACK_MSG_TS = slackResp?.ts ?: ''
                        echo "▶ Approval message posted | ts=${env.SLACK_MSG_TS}"

                        cdLog('3c · Slack Approval Gate', "MESSAGE SENT — waiting up to ${APPROVAL_TIMEOUT_HRS}h for response")
                    }

                    // ── Human-in-the-loop pause ──────────────────────────────
                    // The Jenkins `input` step blocks here until:
                    //   (a) webhook-receiver POSTs an approve/reject decision, OR
                    //   (b) timeout expires → auto-reject
                    //
                    // The webhook-receiver (devops/slack/webhook-receiver.py) validates
                    // the Slack signing secret, extracts the action, and calls:
                    //   POST /jenkins/job/gym-cd/<BUILD_NUMBER>/input/<INPUT_ID>/proceedEmpty
                    //
                    def decision = null
                    try {
                        timeout(time: APPROVAL_TIMEOUT_HRS.toInteger(), unit: 'HOURS') {
                            decision = input(
                                id         : 'deploy-approval',
                                message    : "⏳ Awaiting Slack approval for ${APP_NAME}:${params.IMAGE_TAG}",
                                submitterParameter: 'APPROVER_ID',
                                parameters : [
                                    choice(
                                        name       : 'DEPLOY_DECISION',
                                        choices    : ['APPROVE', 'REJECT'],
                                        description: 'Approve or Reject the deployment'
                                    ),
                                    string(
                                        name       : 'APPROVER_COMMENT',
                                        defaultValue: '',
                                        description: 'Optional comment from approver'
                                    )
                                ]
                            )
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                        // Timeout expired → auto-reject
                        cdLog('3c · Slack Approval Gate', "AUTO-REJECTED — timeout of ${APPROVAL_TIMEOUT_HRS}h exceeded")
                        env.APPROVAL_DECISION = 'REJECTED'
                        env.APPROVER_ID       = 'system/timeout'
                        withCredentials([string(credentialsId: SLACK_BOT_TOKEN_CRED_ID, variable: 'SLACK_BOT_TOKEN')]) {
                            postSlackReply(
                                SLACK_APPROVALS_CHANNEL,
                                env.SLACK_MSG_TS,
                                "⏰ *Deployment AUTO-REJECTED* — approval timeout of ${APPROVAL_TIMEOUT_HRS}h exceeded.\nDeployment of `${APP_NAME}:${params.IMAGE_TAG}` was NOT deployed.",
                                env.SLACK_BOT_TOKEN
                            )
                        }
                        auditLog('REJECTED', 'system/timeout', 'Auto-rejected: timeout exceeded')
                        error "Deployment auto-rejected: approval timeout exceeded."
                    }

                    // ── Record approval decision ─────────────────────────────
                    env.APPROVAL_DECISION  = decision?.DEPLOY_DECISION  ?: 'REJECTED'
                    env.APPROVER_ID        = decision?.APPROVER_ID       ?: 'unknown'
                    env.APPROVER_COMMENT   = decision?.APPROVER_COMMENT ?: ''

                    auditLog(env.APPROVAL_DECISION, env.APPROVER_ID, env.APPROVER_COMMENT)
                    cdLog('3c · Slack Approval Gate', "DECISION=${env.APPROVAL_DECISION} by approver=${env.APPROVER_ID}")

                    if (env.APPROVAL_DECISION == 'REJECT' || env.APPROVAL_DECISION == 'REJECTED') {
                        // Stage 3d will handle the rejection post and notification
                        env.DEPLOYMENT_REJECTED = 'true'
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  3d. POST-APPROVAL AI ENHANCEMENT
        //  • APPROVE → deployment runbook (monitoring focus, rollback cmds)
        //  • REJECT  → rejection summary + suggested fixes
        // ════════════════════════════════════════════════════════════════════
        stage('3d · Post-Approval AI Enhancement') {
            steps {
                script {
                    cdLog('3d · Post-Approval AI Enhancement', "START — decision=${env.APPROVAL_DECISION}")
                    withCredentials([
                        string(credentialsId: AI_API_KEY_CRED_ID,       variable: 'AI_API_KEY'),
                        string(credentialsId: SLACK_BOT_TOKEN_CRED_ID,  variable: 'SLACK_BOT_TOKEN')
                    ]) {
                        def requestType = (env.APPROVAL_DECISION == 'APPROVE') ? 'deployment_runbook' : 'rejection_analysis'

                        def payload = groovy.json.JsonOutput.toJson([
                            type           : requestType,
                            app_name       : APP_NAME,
                            image_tag      : params.IMAGE_TAG,
                            risk_level     : env.AI_RISK_LEVEL,
                            ai_summary     : env.AI_SUMMARY,
                            approver       : env.APPROVER_ID,
                            comment        : env.APPROVER_COMMENT,
                            rollback_cmd   : "argocd app rollback ${ARGOCD_APP_NAME} --server ${ARGOCD_SERVER}"
                        ])
                        writeFile file: 'ai-postapproval-request.json', text: payload

                        sh """
                            set -euo pipefail
                            curl -sf \
                              -X POST \
                              -H "Content-Type: application/json" \
                              -H "X-API-Key: \${AI_API_KEY}" \
                              --max-time 90 \
                              --data @ai-postapproval-request.json \
                              "${AI_SERVICE_URL}/analyze/post-approval" \
                              -o ai-postapproval.json || true
                        """
                        sh 'rm -f ai-postapproval-request.json || true'

                        if (fileExists('ai-postapproval.json')) {
                            def postAI = readJSON file: 'ai-postapproval.json'

                            if (env.APPROVAL_DECISION == 'APPROVE') {
                                def runbookText = postAI?.runbook ?: 'Standard deployment runbook applies.'
                                postSlackReply(
                                    SLACK_APPROVALS_CHANNEL,
                                    env.SLACK_MSG_TS,
                                    "✅ *Deployment APPROVED* by `${env.APPROVER_ID}`\n\n🤖 *AI Deployment Runbook* _(AI-generated — human review required)_\n${runbookText}",
                                    env.SLACK_BOT_TOKEN
                                )
                            } else {
                                def fixList = postAI?.suggested_fixes ?: 'Review scan results and resubmit.'
                                postSlackReply(
                                    SLACK_APPROVALS_CHANNEL,
                                    env.SLACK_MSG_TS,
                                    "🚫 *Deployment REJECTED* by `${env.APPROVER_ID}`\n*Comment:* ${env.APPROVER_COMMENT}\n\n🤖 *AI Suggested Fixes* _(AI-generated — human review required)_\n${fixList}",
                                    env.SLACK_BOT_TOKEN
                                )
                            }
                        }
                    }
                    cdLog('3d · Post-Approval AI Enhancement', 'DONE')

                    // Hard-stop if rejected — stages 3e/3f/3g will be skipped
                    if (env.APPROVAL_DECISION != 'APPROVE') {
                        error "Deployment REJECTED by ${env.APPROVER_ID}. Pipeline halted."
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'ai-postapproval.json', allowEmptyArchive: true, fingerprint: true
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  3e. GITOPS MANIFEST UPDATE
        //
        //  Strategy: same-branch GitOps on `main` (see explanation doc).
        //  Uses `yq` (preferred) with `sed` as fallback to patch image.tag.
        //  AI generates the commit message for clean audit trail.
        // ════════════════════════════════════════════════════════════════════
        stage('3e · GitOps Manifest Update') {
            steps {
                script {
                    cdLog('3e · GitOps Manifest Update', 'START')
                    withCredentials([
                        usernamePassword(
                            credentialsId: GITHUB_CRED_ID,
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_TOKEN'
                        ),
                        string(credentialsId: AI_API_KEY_CRED_ID, variable: 'AI_API_KEY')
                    ]) {

                        // ── Generate AI commit message ─────────────────────
                        def commitPayload = groovy.json.JsonOutput.toJson([
                            type      : 'commit_message',
                            app_name  : APP_NAME,
                            old_tag   : 'previous',
                            new_tag   : params.IMAGE_TAG,
                            branch    : params.GIT_BRANCH,
                            commit    : params.GIT_COMMIT.take(7),
                            risk_level: env.AI_RISK_LEVEL
                        ])
                        writeFile file: 'ai-commit-request.json', text: commitPayload

                        def commitMsg = sh(
                            script: """
                                RESP=\$(curl -sf \
                                  -X POST \
                                  -H "Content-Type: application/json" \
                                  -H "X-API-Key: \${AI_API_KEY}" \
                                  --max-time 60 \
                                  --data @ai-commit-request.json \
                                  "${AI_SERVICE_URL}/generate/commit-message" 2>/dev/null)
                                echo "\${RESP}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('message','chore(deploy): update gym image to ${params.IMAGE_TAG}'))" 2>/dev/null \
                                  || echo "chore(deploy): update gym image tag to ${params.IMAGE_TAG} [AI]"
                            """,
                            returnStdout: true
                        ).trim()
                        sh 'rm -f ai-commit-request.json || true'

                        echo "▶ Commit message: ${commitMsg}"

                        // ── Patch helm/gym/values.yaml ────────────────────
                        sh """
                            set -euo pipefail

                            # Configure git identity for the GitOps commit
                            git config user.email "jenkins-cd@gym.internal"
                            git config user.name  "Jenkins CD"

                            # Ensure we are on the gitops branch (already checked out by CI trigger)
                            git checkout ${GITOPS_BRANCH}
                            git pull --rebase origin ${GITOPS_BRANCH}

                            VALUES_FILE="${HELM_CHART_PATH}/values.yaml"

                            # Preferred: use yq for precise YAML mutation
                            if command -v yq &>/dev/null; then
                                yq e '.app.image.tag = "${params.IMAGE_TAG}"' -i "\${VALUES_FILE}"
                                echo "▶ yq patch applied"
                            else
                                # Fallback: sed (safe for simple tag: <string> patterns)
                                sed -i 's|^\\(\\s*tag:\\s*\\).*|\\1${params.IMAGE_TAG}|' "\${VALUES_FILE}"
                                echo "▶ sed patch applied (yq not found)"
                            fi

                            grep 'tag:' "\${VALUES_FILE}" | head -3
                            
                            # Stage, commit, push
                            git add "\${VALUES_FILE}"
                            git commit -m "${commitMsg}"

                            # Push via HTTPS with token (PAT) — no SSH key needed
                            REPO_URL=\$(git remote get-url origin \
                              | sed 's|https://|https://\${GIT_USER}:\${GIT_TOKEN}@|')
                            git push "\${REPO_URL}" ${GITOPS_BRANCH}

                            echo "▶ GitOps commit pushed to ${GITOPS_BRANCH}"
                        """
                    }
                    cdLog('3e · GitOps Manifest Update', "DONE — tag=${params.IMAGE_TAG} committed to ${GITOPS_BRANCH}")
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  3f. ARGOCD SYNC + HEALTH POLL
        //  Force-syncs the ArgoCD application and waits until Healthy.
        //  CD job is only marked green when ArgoCD confirms health.
        // ════════════════════════════════════════════════════════════════════
        stage('3f · ArgoCD Sync') {
            steps {
                script {
                    cdLog('3f · ArgoCD Sync', 'START')
                    withCredentials([string(credentialsId: ARGOCD_TOKEN_CRED_ID, variable: 'ARGOCD_AUTH_TOKEN')]) {
                        sh """
                            set -euo pipefail

                            echo "▶ Triggering ArgoCD sync for application: ${ARGOCD_APP_NAME}"
                            argocd app sync ${ARGOCD_APP_NAME} \
                              --server   ${ARGOCD_SERVER} \
                              --auth-token \${ARGOCD_AUTH_TOKEN} \
                              --force \
                              --timeout 300 \
                              --insecure

                            echo "▶ Waiting for application to become Healthy..."
                            argocd app wait ${ARGOCD_APP_NAME} \
                              --server   ${ARGOCD_SERVER} \
                              --auth-token \${ARGOCD_AUTH_TOKEN} \
                              --health \
                              --timeout 600 \
                              --insecure

                            echo "▶ ArgoCD application is Healthy ✅"

                            # Capture sync status for the deployment summary
                            argocd app get ${ARGOCD_APP_NAME} \
                              --server ${ARGOCD_SERVER} \
                              --auth-token \${ARGOCD_AUTH_TOKEN} \
                              --insecure \
                              -o json > argocd-status.json || true
                        """
                    }
                    cdLog('3f · ArgoCD Sync', 'DONE — application Healthy')
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'argocd-status.json', allowEmptyArchive: true, fingerprint: true
                }
                failure {
                    script {
                        cdLog('3f · ArgoCD Sync', 'FAILED — application did not reach Healthy state')
                        withCredentials([string(credentialsId: SLACK_BOT_TOKEN_CRED_ID, variable: 'SLACK_BOT_TOKEN')]) {
                            postSlackMsg(
                                SLACK_DEPLOYMENTS_CHANNEL,
                                "🔴 *ArgoCD sync FAILED* for `${APP_NAME}:${params.IMAGE_TAG}`\n" +
                                "Application did not reach Healthy state within 10 minutes.\n" +
                                "Rollback command: `helm rollback gym -n gym-app`\n" +
                                "<${env.BUILD_URL}|View Jenkins Build>",
                                env.SLACK_BOT_TOKEN
                            )
                        }
                    }
                }
            }
        }

        // ════════════════════════════════════════════════════════════════════
        //  3g. POST-DEPLOYMENT VERIFICATION (10-minute AI health watch)
        //  AI compares pre/post metrics; generates incident report on anomaly.
        // ════════════════════════════════════════════════════════════════════
        stage('3g · Post-Deployment Verification') {
            steps {
                script {
                    cdLog('3g · Post-Deployment Verification', "START — watching for ${POST_DEPLOY_WATCH_SEC}s")

                    // Wait for metrics to stabilise before sampling
                    echo "▶ Waiting 60s for deployment to stabilise..."
                    sleep(60)

                    // Sample post-deployment metrics
                    def postMetrics = collectMetricsBaseline()

                    withCredentials([
                        string(credentialsId: AI_API_KEY_CRED_ID,      variable: 'AI_API_KEY'),
                        string(credentialsId: SLACK_BOT_TOKEN_CRED_ID, variable: 'SLACK_BOT_TOKEN')
                    ]) {
                        def verifyPayload = groovy.json.JsonOutput.toJson([
                            type           : 'post_deployment_verification',
                            app_name       : APP_NAME,
                            image_tag      : params.IMAGE_TAG,
                            watch_seconds  : POST_DEPLOY_WATCH_SEC.toInteger(),
                            pre_metrics    : env.PRE_DEPLOY_METRICS,
                            post_metrics   : postMetrics,
                            argocd_status  : fileExists('argocd-status.json')
                                               ? readFile('argocd-status.json').take(2000)
                                               : '{}'
                        ])
                        writeFile file: 'ai-verify-request.json', text: verifyPayload

                        // Extended watch period — AI service polls internally
                        sh """
                            set -euo pipefail
                            curl -sf \
                              -X POST \
                              -H "Content-Type: application/json" \
                              -H "X-API-Key: \${AI_API_KEY}" \
                              --max-time ${POST_DEPLOY_WATCH_SEC.toInteger() + 60} \
                              --data @ai-verify-request.json \
                              "${AI_SERVICE_URL}/verify/post-deployment" \
                              -o ai-post-deploy-report.json || true
                        """
                        sh 'rm -f ai-verify-request.json || true'

                        def anomalyDetected = false
                        def deployReport = [:]

                        if (fileExists('ai-post-deploy-report.json')) {
                            deployReport   = readJSON file: 'ai-post-deploy-report.json'
                            anomalyDetected = deployReport?.anomaly_detected == true
                        }

                        // ── Post summary to #deployments ──────────────────
                        if (anomalyDetected) {
                            cdLog('3g · Post-Deployment Verification', 'ANOMALY DETECTED — posting incident report')
                            postSlackMsg(
                                SLACK_DEPLOYMENTS_CHANNEL,
                                buildDeployAnomalyMessage(deployReport, params.IMAGE_TAG, APP_NAME, env.BUILD_URL),
                                env.SLACK_BOT_TOKEN
                            )
                            // Non-fatal: CD job remains green; incident is informational
                            currentBuild.result = 'UNSTABLE'
                        } else {
                            postSlackMsg(
                                SLACK_DEPLOYMENTS_CHANNEL,
                                buildDeploySuccessMessage(deployReport, params, APP_NAME, env.BUILD_URL, env.APPROVER_ID),
                                env.SLACK_BOT_TOKEN
                            )
                        }
                    }
                    cdLog('3g · Post-Deployment Verification', 'DONE')
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'ai-post-deploy-report.json', allowEmptyArchive: true, fingerprint: true
                }
            }
        }

    } // end stages

    // ════════════════════════════════════════════════════════════════════════
    //  POST ACTIONS
    // ════════════════════════════════════════════════════════════════════════
    post {
        always {
            script {
                cdLog('PIPELINE', "FINISHED — result=${currentBuild.currentResult}")
                archiveArtifacts artifacts: 'ai-*.json,argocd-*.json', allowEmptyArchive: true
                sh 'rm -f .slack-*.json ai-*-request.json || true'
            }
        }
        success {
            script {
                cdLog('PIPELINE', "SUCCESS — ${APP_NAME}:${params.IMAGE_TAG} deployed and healthy")
            }
        }
        failure {
            script {
                cdLog('PIPELINE', "FAILED — ${APP_NAME}:${params.IMAGE_TAG} NOT deployed")
                withCredentials([string(credentialsId: SLACK_BOT_TOKEN_CRED_ID, variable: 'SLACK_BOT_TOKEN')]) {
                    postSlackMsg(
                        SLACK_APPROVALS_CHANNEL,
                        "⛔ *CD Pipeline FAILED* — `${APP_NAME}:${params.IMAGE_TAG}`\n" +
                        "<${env.BUILD_URL}|View Build Logs>",
                        env.SLACK_BOT_TOKEN
                    )
                }
            }
        }
    }

} // end pipeline

// ═══════════════════════════════════════════════════════════════════════════
//  HELPER FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════

/** Emits a structured CD log line for pipeline observability. */
def cdLog(String stage, String status) {
    def ts = new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
    echo "▶▶ CD_LOG | stage=\"${stage}\" | status=\"${status}\" | build=\"${env.BUILD_NUMBER}\" | tag=\"${params.IMAGE_TAG}\" | ts=\"${ts}\""
}

/**
 * Writes an immutable approval audit record.
 * Stored as a Jenkins artifact for compliance — timestamp, approver, decision.
 */
def auditLog(String decision, String approver, String comment) {
    def ts = new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
    def record = groovy.json.JsonOutput.toJson([
        timestamp  : ts,
        job        : env.JOB_NAME,
        build      : env.BUILD_NUMBER,
        app        : env.APP_NAME,
        image_tag  : params.IMAGE_TAG,
        git_commit : params.GIT_COMMIT,
        git_branch : params.GIT_BRANCH,
        decision   : decision,
        approver   : approver,
        comment    : comment
    ])
    writeFile file: 'approval-audit.json', text: record
    archiveArtifacts artifacts: 'approval-audit.json', allowEmptyArchive: false, fingerprint: true
    echo "▶▶ AUDIT | decision=${decision} | approver=${approver} | ts=${ts}"
}

/**
 * Collects a lightweight metrics baseline from Prometheus (best-effort).
 * Returns a JSON string safe to pass to AI — no secrets, no PII.
 */
def collectMetricsBaseline() {
    try {
        def metrics = sh(
            script: """
                curl -sf --max-time 10 \
                  'http://prometheus.monitoring.svc.cluster.local:9090/api/v1/query?query=rate(http_requests_total[5m])' \
                  2>/dev/null || echo '{}'
            """,
            returnStdout: true
        ).trim().take(1000)
        return metrics
    } catch (e) {
        return '{"status": "metrics unavailable"}'
    }
}

/** Posts a simple text Slack message to a channel. */
def postSlackMsg(String channel, String text, String token) {
    def payload = groovy.json.JsonOutput.toJson([channel: channel, text: text])
    writeFile file: '.slack-msg.json', text: payload
    sh """
        curl -sf \
          -X POST https://slack.com/api/chat.postMessage \
          -H "Authorization: Bearer ${token}" \
          -H "Content-Type: application/json" \
          --data @.slack-msg.json || true
        rm -f .slack-msg.json
    """
}

/** Posts a threaded reply on an existing Slack message (uses thread_ts). */
def postSlackReply(String channel, String ts, String text, String token) {
    def payload = ts
        ? groovy.json.JsonOutput.toJson([channel: channel, thread_ts: ts, text: text])
        : groovy.json.JsonOutput.toJson([channel: channel, text: text])
    writeFile file: '.slack-reply.json', text: payload
    sh """
        curl -sf \
          -X POST https://slack.com/api/chat.postMessage \
          -H "Authorization: Bearer ${token}" \
          -H "Content-Type: application/json" \
          --data @.slack-reply.json || true
        rm -f .slack-reply.json
    """
}

/**
 * Builds the Slack Block Kit message for the interactive approval gate (3c).
 * Conforms to the exact format specified in devops.md.
 */
def buildApprovalBlocks(Map ctx) {
    def riskEmoji = [LOW: '🟢', MEDIUM: '🟡', HIGH: '🔴', UNKNOWN: '⚪'].get(ctx.riskLevel?.toUpperCase(), '⚪')
    def commitsFormatted = ctx.commits?.split('\n')
        ?.collect { "• `${it.trim()}`" }
        ?.join('\n') ?: '• No commits available'

    return [
        [type: "header", text: [type: "plain_text", text: "🚀 Deployment Approval Request", emoji: true]],
        [type: "section", fields: [
            [type: "mrkdwn", text: "*Service:*\n`${ctx.appName}`"],
            [type: "mrkdwn", text: "*Version:*\n`${ctx.imageTag}`"],
            [type: "mrkdwn", text: "*Environment:*\nProduction"],
            [type: "mrkdwn", text: "*Branch:*\n`${ctx.branch}`"],
            [type: "mrkdwn", text: "*Commit:*\n`${ctx.commit}`"],
            [type: "mrkdwn", text: "*Image:*\n`${ctx.fullImage}`"]
        ]],
        [type: "divider"],
        [type: "section", text: [type: "mrkdwn",
            text: "${riskEmoji} *AI Risk Assessment:* `${ctx.riskLevel}` _(AI-generated — human review required)_\n\n_AI Summary:_\n${ctx.aiSummary}"]],
        [type: "divider"],
        [type: "section", text: [type: "mrkdwn",
            text: "📊 *Scan Results:*\n• OWASP Dependency-Check: ✅ Passed\n• SonarQube Quality Gate: ✅ Passed\n• Trivy Image Scan: ✅ No HIGH/CRITICAL CVEs"]],
        [type: "section", text: [type: "mrkdwn",
            text: "📝 *Commits in this release:*\n${commitsFormatted}"]],
        [type: "divider"],
        [type: "section", text: [type: "mrkdwn",
            text: "⏰ *Auto-reject in:* ${ctx.timeoutHrs} hours\n<${ctx.buildUrl}|View Jenkins Build #${ctx.buildNum}>"]],
        // Interactive buttons — require Slack App with interactions enabled
        [type: "actions", elements: [
            [
                type     : "button",
                style    : "primary",
                text     : [type: "plain_text", text: "✅ Approve", emoji: true],
                action_id: "deploy_approve",
                value    : "APPROVE|${ctx.buildNum}|${ctx.imageTag}"
            ],
            [
                type     : "button",
                style    : "danger",
                text     : [type: "plain_text", text: "🚫 Reject", emoji: true],
                action_id: "deploy_reject",
                value    : "REJECT|${ctx.buildNum}|${ctx.imageTag}",
                confirm  : [
                    title  : [type: "plain_text", text: "Confirm Rejection"],
                    text   : [type: "mrkdwn", text: "Are you sure you want to *reject* this deployment?"],
                    confirm: [type: "plain_text", text: "Yes, Reject"],
                    deny   : [type: "plain_text", text: "Cancel"]
                ]
            ],
            [
                type     : "button",
                text     : [type: "plain_text", text: "ℹ️ More Info", emoji: true],
                action_id: "deploy_info",
                value    : "INFO|${ctx.buildNum}|${ctx.imageTag}",
                url      : ctx.buildUrl
            ]
        ]]
    ]
}

/** Builds the Slack post-deploy anomaly message for #deployments. */
def buildDeployAnomalyMessage(Map report, String tag, String app, String buildUrl) {
    return "⚠️ *Post-Deployment Anomaly Detected* — `${app}:${tag}`\n\n" +
           "🤖 *AI Incident Report* _(AI-generated — human review required)_\n" +
           "${report?.incident_summary ?: 'Anomalous metrics detected after deployment.'}\n\n" +
           "*Suggested Actions:*\n${report?.suggested_actions ?: 'Check pod logs and error rates.'}\n\n" +
           "*Rollback Command:*\n`helm rollback gym -n gym-app`\n" +
           "<${buildUrl}|View Build>"
}

/** Builds the Slack post-deploy success message for #deployments. */
def buildDeploySuccessMessage(Map report, def params, String app, String buildUrl, String approver) {
    return "🎉 *Deployment Successful* — `${app}:${params.IMAGE_TAG}`\n\n" +
           "✅ All post-deployment health checks passed\n" +
           "*Approved by:* `${approver}`\n" +
           "*Branch:* `${params.GIT_BRANCH}`\n" +
           "*Commit:* `${params.GIT_COMMIT.take(7)}`\n\n" +
           "🤖 *AI Health Summary* _(AI-generated)_\n" +
           "${report?.health_summary ?: 'Application is healthy. No anomalies detected.'}\n\n" +
           "<${buildUrl}|View Jenkins Build>"
}
