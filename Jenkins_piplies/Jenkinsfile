pipeline {
    agent any

    environment {
        NODE_VERSION = '25'

        DB_HOST     = '127.0.0.1'
        DB_PORT     = '5432'
        DB_USER     = 'postgres'
        DB_NAME     = 'gym_test'
        JWT_SECRET  = 'supersecretkey'
        NODE_ENV    = 'test'

        DB_PASS = 'postgres-test-password'
    }

    stages {

        // ── 1. Checkout ──────────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── 2. Debug Git Info ────────────────────────────────────────────────────
        stage('Debug Git Info') {
            steps {
                echo "GIT_COMMIT: ${env.GIT_COMMIT}"
                echo "GIT_BRANCH: ${env.GIT_BRANCH}"
            }
        }

        // ── 3. Install Dependencies ──────────────────────────────────────────────
        stage('Install Dependencies') {
            steps {
                nodejs(nodeJSInstallationName: 'NodeJS 25') {
                    sh 'npm ci'
                }
            }
        }

        // ── 4. Lint ──────────────────────────────────────────────────────────────
        stage('Lint') {
            steps {
                nodejs(nodeJSInstallationName: 'NodeJS 25') {
                    sh 'npm run lint'
                }
            }
        }

        // ── 5. Security Scans (parallel) ─────────────────────────────────────────
        // All three sub-stages are INFORMATIONAL only — they will never block or
        // interrupt the rest of the pipeline, regardless of what they find.
        stage('Security Scans') {
            parallel {

                stage('Secret Scanning (Gitleaks)') {
                    steps {
                        // --exit-code 0  → findings are printed but do NOT fail the stage
                        // --no-git       → scan all files, not only git-tracked ones
                        // .gitleaksignore excludes Trivy's .cache dir (false positives)
                        sh '''
                            docker run --rm \
                              -v "$WORKSPACE":/path \
                              -w /path \
                              zricethezav/gitleaks:latest detect \
                                --source=. -v --no-git \
                                --exit-code 0 \
                                --gitleaks-ignore-path=.cache || true
                        '''
                    }
                }

                stage('Dependency Scanning (Trivy)') {
                    steps {
                        // --exit-code 0 → informational; never fails the pipeline
                        sh '''
                            docker run --rm \
                              -v "$WORKSPACE":/project \
                              aquasec/trivy:latest fs /project \
                              --severity HIGH,CRITICAL \
                              --scanners vuln,secret,misconfig \
                              --exit-code 0
                        '''
                    }
                }

                stage('SAST (njsscan)') {
                    steps {
                        // || true → SAST findings are informational; never block the pipeline
                        sh '''
                            docker run --rm \
                              -v "$WORKSPACE":/src \
                              opensecurity/njsscan:latest /src || true
                        '''
                    }
                }
            }
        }

        // ── 6. Test ──────────────────────────────────────────────────────────────
        stage('Test') {
            steps {
                script {
                    sh '''
                        docker run -d \
                          --name test-postgres \
                          -e POSTGRES_USER=postgres \
                          -e POSTGRES_PASSWORD=postgres-test-password \
                          -e POSTGRES_DB=gym_test \
                          -p 5432:5432 \
                          postgres:17-alpine
                    '''

                    sh 'sleep 10'

                    try {
                        nodejs(nodeJSInstallationName: 'NodeJS 25') {
                            sh 'npm run test:cov -- --passWithNoTests --forceExit'
                        }
                    } finally {
                        sh 'docker rm -f test-postgres || true'
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
                }
            }
        }

        // ── 7. Build & Push Docker Image ─────────────────────────────────────────
        stage('Build & Push Docker Image') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'origin/master'
                }
            }
            environment {
                DOCKERHUB_CREDS = credentials('dockerhub-credentials')
            }
            steps {
                script {
                    def imageTag    = env.GIT_COMMIT.take(7)
                    def dockerImage = "${env.DOCKERHUB_CREDS_USR}/gym"

                    sh "docker build -t ${dockerImage}:${imageTag} -t ${dockerImage}:latest ."

                    sh "echo ${env.DOCKERHUB_CREDS_PSW} | docker login -u ${env.DOCKERHUB_CREDS_USR} --password-stdin"

                    sh "docker push ${dockerImage}:${imageTag}"
                    sh "docker push ${dockerImage}:latest"

                    sh 'docker logout'
                }
            }
        }
    }

    post {
        failure {
            echo "Pipeline FAILED on branch ${env.GIT_BRANCH} at commit ${env.GIT_COMMIT}"
        }
        success {
            echo "Pipeline completed successfully for ${env.GIT_BRANCH}"
        }
    }
}
