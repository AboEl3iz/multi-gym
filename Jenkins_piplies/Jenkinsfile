pipeline {
    agent any

    environment {
        // We will define environment variables used across different stages
        NODE_VERSION = '25'
        
        // Testing DB Variables
        DB_HOST = '127.0.0.1' // Maps to docker container port mapped on host
        DB_PORT = '5432'
        DB_USER = 'postgres'
        DB_PASS = '2832003'
        DB_NAME = 'gym_test'
        JWT_SECRET = 'supersecretkey'
        NODE_ENV = 'test'
    }

    stages {
       stage('Checkout') {
    steps {
        checkout scm
    }
}

stage('Debug Git Info') {
    steps {
        echo "GIT_COMMIT: ${env.GIT_COMMIT}"
        echo "GIT_BRANCH: ${env.GIT_BRANCH}"
    }
}

        stage('Lint') {
            steps {
                // Uses the NodeJS plugin configured in Jenkins
                nodejs(nodeJSInstallationName: 'NodeJS 25') {
                    sh 'npm ci'
                    sh 'npm run lint'
                }
            }
        }

        stage('Security Scans') {
            parallel {
               stage('Secret Scanning (Gitleaks)') {
            steps {
                sh """
                docker run --rm -v $WORKSPACE:/path -w /path zricethezav/gitleaks:latest detect --source=. -v --no-git
                """
            }
        }
        stage('Dependency Scanning (Trivy)') {
            steps {
                sh """
docker run --rm \
  -v $WORKSPACE:/project \
  aquasec/trivy:latest fs /project \
  --severity HIGH,CRITICAL \
  --scanners vuln,secret,misconfig \
  --exit-code 0
"""
            }
        }
        stage('SAST (njsscan)') {
            steps {
                sh """
                docker run --rm -v $WORKSPACE:/src opensecurity/njsscan:latest /src
                """
            }
        }
    
            }
        }

        stage('Test') {
            steps {
                script {
                    // Start PostgreSQL container for tests
                    // We map ports so the host (127.0.0.1) can access them inside tests
                    sh 'docker run -d --name test-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=2832003 -e POSTGRES_DB=gym_test -p 5432:5432 postgres:17-alpine'
                    
                    // Wait briefly for databases to initialize
                    sh 'sleep 10'

                    try {
                        nodejs(nodeJSInstallationName: 'NodeJS 25') {
                            sh 'npm ci'
                            sh 'npm test -- --passWithNoTests --forceExit'
                            sh 'npm run test:cov -- --passWithNoTests --forceExit'
                        }
                    } finally {
                        // Cleanup temporary containers so they don't break subsequent builds
                        sh 'docker rm -f test-postgres || true'
                    }
                }
            }
            post {
                always {
                    // Upload coverage report artifact
                    archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
                }
            }
        }

        stage('Build & Push Docker Image') {
            // Equivalent to "on: push branches: [main, master]" + "if:" statements
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'origin/master'
                }
                }
            environment {
                // Safely load credentials from Jenkins credential store
                DOCKERHUB_CREDS = credentials('dockerhub-credentials')
            }
            steps {
                script {
                    // Get short commit hash for tagging
                    def imageTag = env.GIT_COMMIT.take(7)
                    def dockerImage = "${env.DOCKERHUB_CREDS_USR}/gym"
                    
                    // Build the Docker Image
                    sh "docker build -t ${dockerImage}:${imageTag} -t ${dockerImage}:latest ."
                    
                    // Login using the password stored in credentials
                    sh "echo ${env.DOCKERHUB_CREDS_PSW} | docker login -u ${env.DOCKERHUB_CREDS_USR} --password-stdin"
                    
                    // Push BOTH tags to Docker Hub
                    sh "docker push ${dockerImage}:${imageTag}"
                    sh "docker push ${dockerImage}:latest"
                }
            }
        }
    }
}
