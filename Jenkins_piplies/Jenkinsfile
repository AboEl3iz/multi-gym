pipeline {
    agent any

    environment {
        NODE_VERSION = '25'

        DB_HOST     = '127.0.0.1'
        DB_PORT     = '5432'
        DB_USER     = 'postgres'
        DB_NAME     = 'gym_test'
        JWT_SECRET  = 'supersecretkey'
        NODE_ENV    = 'test'

        DB_PASS = 'postgres-test-password'
    }

    stages {

        // ── 1. Checkout ──────────────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── 2. Debug Info ─────────────────────────────────────────────────────────
        // Verified: WORKSPACE = /var/jenkins_home/workspace/karim_karim[@N]
        // The @N suffix is added by Jenkins when parallel builds use separate workspaces — this is normal.
        stage('Debug Info') {
            steps {
                echo "GIT_BRANCH: ${env.GIT_BRANCH}"
                echo "GIT_COMMIT: ${env.GIT_COMMIT}"
                echo "WORKSPACE:  ${env.WORKSPACE}"
            }
        }

        // ── 3. Install Dependencies ──────────────────────────────────────────────
        stage('Install Dependencies') {
            steps {
                nodejs(nodeJSInstallationName: 'NodeJS 25') {
                    sh 'npm ci'
                }
            }
        }

        // ── 4. Lint ──────────────────────────────────────────────────────────────
        stage('Lint') {
            steps {
                nodejs(nodeJSInstallationName: 'NodeJS 25') {
                    sh 'npm run lint'
                }
            }
        }

        // ── 5. Security Scans (parallel) ─────────────────────────────────────────
        
        stage('Security Scans') {
            parallel {

                stage('Secret Scanning (Gitleaks)') {
                    steps {
                        
                        sh '''
                            docker run --rm \
                              -v "$WORKSPACE":/path \
                              -w /path \
                              zricethezav/gitleaks:latest detect \
                                --source=. -v --no-git \
                                --exit-code 0 \
                                --gitleaks-ignore-path=.cache || true
                                
                        '''
                    }
                }

                stage('Dependency Scanning (Trivy)') {
                    steps {
                        
                        retry(3) {
                             sh '''
            # Set up Trivy binary directory
            export TRIVY_DIR="$WORKSPACE_TMP/trivy-bin"
            mkdir -p "$TRIVY_DIR"

            # Download Trivy if not cached
            if [ ! -f "$TRIVY_DIR/trivy" ]; then
                curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
                    | sh -s -- -b "$TRIVY_DIR" latest
            fi

            # Use separate Trivy cache to avoid scanning Trivy DB
            export TRIVY_CACHE="/tmp/trivy-cache"

            # Run Trivy on the repo only, skip node_modules and Trivy's own cache
            "$TRIVY_DIR/trivy" fs . \
                --severity HIGH,CRITICAL \
                --scanners vuln,misconfig \
                --skip-dirs .cache,node_modules \
                --exit-code 0 > trivy-report.txt || true
            cat trivy-report.txt
        '''
                        }
                    }
                }

                stage('SAST (njsscan)') {
                    steps {
                        sh '''
                            docker run --rm \
                              -v "$WORKSPACE":/src \
                              opensecurity/njsscan:latest /src > njsscan-report.txt || true
                            cat njsscan-report.txt || true
                        '''
                    }
                }
            }
        }

        // ── 6. Test ──────────────────────────────────────────────────────────────
        stage('Test') {
            steps {
                script {
                    sh '''
                        docker run -d \
                          --name test-postgres \
                          -e POSTGRES_USER=postgres \
                          -e POSTGRES_PASSWORD=postgres-test-password \
                          -e POSTGRES_DB=gym_test \
                          -p 5432:5432 \
                          postgres:17-alpine
                    '''

                    sh 'sleep 10'

                    try {
                        nodejs(nodeJSInstallationName: 'NodeJS 25') {
                            sh 'npm run test:cov -- --passWithNoTests --forceExit'
                        }
                    } finally {
                        sh 'docker rm -f test-postgres || true'
                    }
                }
            }
           
        }

        // ── 7. Build & Push Docker Image ─────────────────────────────────────────
        stage('Build & Push Docker Image') {
            when {
                expression {
                    return env.GIT_BRANCH == 'origin/main' || env.GIT_BRANCH == 'origin/master'
                }
            }
            environment {
                DOCKERHUB_CREDS = credentials('dockerhub-credentials')
            }
            steps {
                script {
                    def imageTag    = env.GIT_COMMIT.take(7)
                    def dockerImage = "${env.DOCKERHUB_CREDS_USR}/gym"

                    sh "docker build -t ${dockerImage}:${imageTag} -t ${dockerImage}:latest ."

                    sh "echo ${env.DOCKERHUB_CREDS_PSW} | docker login -u ${env.DOCKERHUB_CREDS_USR} --password-stdin"

                    sh "docker push ${dockerImage}:${imageTag}"
                    sh "docker push ${dockerImage}:latest"

                    sh 'docker logout'
                }
            }
        }
    }

    post {
        always {
            script {
                collectLogsAndArtifacts()
            }
        }
        success {
            echo "Pipeline completed successfully for ${env.GIT_BRANCH}"
            script {
                sendNotification('SUCCESS')
            }
        }
        failure {
            echo "Pipeline FAILED on branch ${env.GIT_BRANCH} at commit ${env.GIT_COMMIT}"
            script {
                sendNotification('FAILURE')
            }
        }
        aborted {
            echo "Pipeline ABORTED on branch ${env.GIT_BRANCH} at commit ${env.GIT_COMMIT}"
            script {
                sendNotification('ABORTED')
            }
        }
    }
}

// ── Helper Functions ───────────────────────────────────────────────────────

/**
 * Collects and archives logs and build artifacts.
 */
def collectLogsAndArtifacts() {
    echo "Collecting logs and artifacts..."
    
    archiveArtifacts artifacts: 'coverage/**', allowEmptyArchive: true
    
    sh "echo 'Pipeline run info: Branch -> ${env.GIT_BRANCH}, Commit -> ${env.GIT_COMMIT}' > pipeline_summary.log"
    archiveArtifacts artifacts: 'pipeline_summary.log', allowEmptyArchive: true
    archiveArtifacts artifacts: '*-report.txt', allowEmptyArchive: true
}

/**
 * Sends notifications to common channels (e.g., Slack, Email) based on build status.
 */
def sendNotification(String buildStatus) {
    def subject = "${buildStatus}: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'"
    
    def trivyReport = fileExists('trivy-report.txt') ? readFile('trivy-report.txt') : 'Trivy report not generated or not found.'
    def njsscanReport = fileExists('njsscan-report.txt') ? readFile('njsscan-report.txt') : 'njsscan report not generated or not found.'
    
    // Truncate logs if they are too large to keep the email readable
    if (trivyReport.length() > 5000) { trivyReport = trivyReport.substring(0, 5000) + '\\n... [Report Truncated]' }
    if (njsscanReport.length() > 5000) { njsscanReport = njsscanReport.substring(0, 5000) + '\\n... [Report Truncated]' }
    
    // HTML escape to avoid messing up the email layout
    trivyReport = trivyReport.replace('<', '&lt;').replace('>', '&gt;')
    njsscanReport = njsscanReport.replace('<', '&lt;').replace('>', '&gt;')
    
    def body = """
        <h2>Jenkins Build Notification</h2>
        <p><b>Status:</b> ${buildStatus}</p>
        <p><b>Job:</b> ${env.JOB_NAME}</p>
        <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
        <p><b>Branch:</b> ${env.GIT_BRANCH}</p>
        <p><b>Commit:</b> ${env.GIT_COMMIT}</p>
        <p><b>Build URL:</b> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
        
        <h3>Trivy Security Scan Summary</h3>
        <pre style="background: #f4f4f4; padding: 10px; border-radius: 5px; overflow-x: auto;">${trivyReport}</pre>
        
        <h3>njsscan SAST Summary</h3>
        <pre style="background: #f4f4f4; padding: 10px; border-radius: 5px; overflow-x: auto;">${njsscanReport}</pre>
    """

    emailext(
        subject: subject,
        body: body,
        mimeType: 'text/html',
        to: 'kimo@gmail.com',
        attachLog: true
    )

    echo "Email sent for status ${buildStatus}"
}
